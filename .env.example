# Local-development env. In AWS, all of these live in SSM Parameter Store
# under /sm8-part-bot/* and are loaded at Lambda cold-start.

# ServiceM8
SM8_API_KEY=
SM8_WEBHOOK_SECRET=
SM8_BOT_STAFF_UUID=

# Bigtincan Zunos (OAuth2 client-credentials)
ZUNOS_BASE_URL=https://api.zunos.com
ZUNOS_CLIENT_ID=
ZUNOS_CLIENT_SECRET=
ZUNOS_SEARCH_PATH=/v1/content/search

# EPAN B2B portal
EPAN_BASE_URL=https://b2b.epan.example
EPAN_USERNAME=
EPAN_PASSWORD=

# AWS
PENDING_ORDERS_TABLE=sm8-part-bot-pending-orders
SSM_PREFIX=/sm8-part-bot
