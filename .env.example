# Local-development env. Used by the smoke scripts in /scripts.
# In Azure, plain settings live in Function App application-settings and
# secrets live in Key Vault (loaded via DefaultAzureCredential).

# Set LOCAL_DEV=true to skip Key Vault entirely and read everything from env.
LOCAL_DEV=true

# ServiceM8
SM8_API_KEY=
SM8_WEBHOOK_SECRET=
SM8_BOT_STAFF_UUID=

# Bigtincan Zunos (browser scraping — your normal Zunos web login)
ZUNOS_BASE_URL=https://app.zunos.com
ZUNOS_USERNAME=
ZUNOS_PASSWORD=

# EPAN B2B portal (Panasonic e-Pan, HATS over AS/400)
EPAN_BASE_URL=https://e-pan.panasonic.com.au
EPAN_USERNAME=
EPAN_PASSWORD=

# Azure
STORAGE_ACCOUNT_NAME=
PENDING_ORDERS_TABLE=pendingOrders
KEY_VAULT_URL=

# Anthropic Claude API — optional. When set, used to read PDF parts lists
# intelligently (much more reliable than regex). Without it, the bot falls
# back to regex extraction which works for direct part-number queries but
# is unreliable for "find the PCB for model X" lookups in PDFs.
ANTHROPIC_API_KEY=
