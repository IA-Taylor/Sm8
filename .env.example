# Local-development env. Used by the smoke scripts in /scripts.
# In Azure, plain settings live in Function App application-settings and
# secrets live in Key Vault (loaded via DefaultAzureCredential).

# Set LOCAL_DEV=true to skip Key Vault entirely and read everything from env.
LOCAL_DEV=true

# ServiceM8
SM8_API_KEY=
SM8_WEBHOOK_SECRET=
SM8_BOT_STAFF_UUID=

# Bigtincan Zunos (OAuth2 client-credentials)
ZUNOS_BASE_URL=https://api.zunos.com
ZUNOS_CLIENT_ID=
ZUNOS_CLIENT_SECRET=
ZUNOS_SEARCH_PATH=/v1/content/search

# EPAN B2B portal (Panasonic e-Pan, HATS over AS/400)
EPAN_BASE_URL=https://e-pan.panasonic.com.au
EPAN_USERNAME=
EPAN_PASSWORD=

# Azure
STORAGE_ACCOUNT_NAME=
PENDING_ORDERS_TABLE=pendingOrders
KEY_VAULT_URL=
