{
  "name": "sm8-part-bot",
  "version": "0.1.0",
  "private": true,
  "description": "ServiceM8 -> Zunos -> EPAN automated part-order workflow",
  "main": "dist/handler.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "func start",
    "epan:lookup": "tsx scripts/epan-lookup.ts",
    "epan:order": "tsx scripts/epan-order.ts",
    "zunos:lookup": "tsx scripts/zunos-lookup.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "@azure/data-tables": "^13.3.0",
    "@azure/functions": "^4.5.1",
    "@azure/identity": "^4.4.1",
    "@azure/keyvault-secrets": "^4.8.0",
    "@sparticuz/chromium": "^129.0.0",
    "pdf-parse": "^1.1.1",
    "playwright-core": "^1.48.0"
  },
  "devDependencies": {
    "@types/node": "^20.16.0",
    "@types/pdf-parse": "^1.1.4",
    "dotenv": "^16.4.5",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
