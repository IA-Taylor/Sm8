{
  "name": "sm8-part-bot",
  "version": "0.1.0",
  "private": true,
  "description": "ServiceM8 -> Zunos -> EPAN automated part-order workflow",
  "main": "dist/handler.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "epan:lookup": "tsx scripts/epan-lookup.ts",
    "epan:order": "tsx scripts/epan-order.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.658.0",
    "@aws-sdk/client-ssm": "^3.658.0",
    "@aws-sdk/lib-dynamodb": "^3.658.0",
    "@sparticuz/chromium": "^129.0.0",
    "playwright-core": "^1.48.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.145",
    "@types/node": "^20.16.0",
    "aws-sdk-client-mock": "^4.0.2",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=20"
  }
}
